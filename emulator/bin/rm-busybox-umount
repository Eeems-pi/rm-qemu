#!/bin/bash
exec rm-busybox-exec <<'EOF'
  set -e
  cd /mnt
  sync
  sync
  rc=0
  for m in boot rootA rootB home;do
    if [ ! -d "$m" ] || ! mountpoint -q "$m";then
      continue
    fi
    if umount "$m";then
      continue
    fi
    pids=$(lsof | awk -v d="/mnt/$m" '$1 != 1 && index($4, d) == 1 && !seen[$1]++ {print $1}')
    if [ -n "$pids" ];then
      kill -15 $pids 2>/dev/null
      sleep 2
    fi
    if umount "$m";then
      continue
    fi
    echo "Error: umount $m failed" >&2
    rc=1
  done
  [ "$rc" = 0 ]
EOF
